# =============================================================================
# Poveon: every setting the app needs.
#
# HOW TO USE: you never put real keys in this file. On Vercel, open your project →
# Settings → Environment Variables, and add each name below with its value.
# (For running on your own computer, copy this file to ".env.local" and fill it in.)
#
# NEXT_PUBLIC_ means the value is visible in the browser. Those are safe to share.
# Everything else is SECRET: never paste it in chat, email or WhatsApp.
# =============================================================================

# ----------------------------------------------------------------- The basics
# Your website address, with https and no slash at the end. Used in emails and share links.
NEXT_PUBLIC_SITE_URL=https://healthcheck.example.com


# Your business WhatsApp number: country code + number, digits only (no +, no spaces).
# Example for 0803 123 4567 → 2348031234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ----------------------------------------------------------------- Admin login (/admin)
# Emails (comma-separated) of the people allowed into /admin.
ADMIN_EMAILS=you@example.com
# SECRET: the admin password (at least 12 characters). Everyone in ADMIN_EMAILS uses it.
# To change it: edit it here in Vercel and redeploy. Changing it logs every admin out.
ADMIN_PASSWORD=
# Optional SECRET: any long random text. Makes admin sessions extra hard to forge.
# (If empty, the Supabase service role key is used instead.)
ADMIN_SESSION_SECRET=

# Where team notifications go (new bookings, home test and medication requests).
TEAM_NOTIFICATION_EMAIL=team@example.com

# ----------------------------------------------------------------- Supabase (database + login)
# Where: supabase.com → your project → Project Settings → API (or "API Keys").
# 1) "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# 2) The "anon public" key (Supabase may call it the "publishable" key). Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 3) SECRET: the "service_role" key (or "secret" key). Server only. Treat it like a master password.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------- Resend (emails)
# Where: resend.com → API Keys → Create API key ("Sending access" is enough).
RESEND_API_KEY=
# Who emails come from. The domain must be verified in Resend → Domains.
# Until your domain is verified you can only send test emails to your own Resend account address.
EMAIL_FROM=Poveon <hello@yourdomain.com>

# ----------------------------------------------------------------- Paystack (₦5,000 consults)
# Where: dashboard.paystack.com → Settings → API Keys & Webhooks.
# Use the TEST secret key (starts with sk_test_) until you say we're ready for real payments.
PAYSTACK_SECRET_KEY=sk_test_
# Safety lock. Live keys (sk_live_) are REFUSED unless this is exactly "true".
# Only set it when you're ready to take real money.
PAYSTACK_LIVE_MODE=false

# ----------------------------------------------------------------- Features for later launches
# "Care for your parents" page (/family). Leave as false until the next major launch.
NEXT_PUBLIC_FEATURE_FAMILY_CARE=false
